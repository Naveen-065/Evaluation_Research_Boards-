[Unit]
Description=ZES EDAC relay for ZCU106 A53 Linux
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/opt/zes-edac-relay/zes-edac-relay --bind 0.0.0.0 --port 9106
Restart=on-failure
RestartSec=2
User=nobody
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true

[Install]
WantedBy=multi-user.target
