ADC LVDS OUT3 none: finite-compliance behavioral model
* Driver compliance is ASSUMED; no prediction of silicon damage.
.options reltol=0.002 abstol=1e-9 vntol=1e-6
Vcm cm 0 1.2
Vq q 0 PWL(
+ 0 1
+ 8e-08 1
+ 8.79833333333e-08 1
+ 8.86833333333e-08 -1
+ 9.63166666667e-08 -1
+ 9.70166666667e-08 1
+ 1.21316666667e-07 1
+ 1.22016666667e-07 -1
+ 1.2965e-07 -1
+ 1.3035e-07 1
+ 1.5465e-07 1
+ 1.5535e-07 -1
+ 1.71316666667e-07 -1
+ 1.72016666667e-07 1
+ 1.87983333333e-07 1
+ 1.88683333333e-07 -1
+ 2.0465e-07 -1
+ 2.0535e-07 1
+ 2.12983333333e-07 1
+ 2.13683333333e-07 -1
+ 2.21316666667e-07 -1
+ 2.22016666667e-07 1
+ 2.2965e-07 1
+ 2.3035e-07 -1
+ 2.37983333333e-07 -1
+ 2.38683333333e-07 1
+ 2.46316666667e-07 1
+ 2.47016666667e-07 -1
+ 2.5465e-07 -1
+ 2.5535e-07 1
+ 3.12983333333e-07 1
+ 3.13683333333e-07 -1
+ 3.62983333333e-07 -1
+ 3.63683333333e-07 1
+ 3.71316666667e-07 1
+ 3.72016666667e-07 -1
+ 4.12983333333e-07 -1
+ 4.13683333333e-07 1
+ 4.2965e-07 1
+ 4.3035e-07 -1
+ 4.62983333333e-07 -1
+ 4.63683333333e-07 1
+ 4.71316666667e-07 1
+ 4.72016666667e-07 -1
+ 4.7965e-07 -1
+ 4.8035e-07 1
+ 4.87983333333e-07 1
+ 4.88683333333e-07 -1
+ 5.12983333333e-07 -1
+ 5.13683333333e-07 1
+ 5.46316666667e-07 1
+ 5.47016666667e-07 -1
+ 5.62983333333e-07 -1
+ 5.63683333333e-07 1
+ 5.71316666667e-07 1
+ 5.72016666667e-07 -1
+ 5.96316666667e-07 -1
+ 5.97016666667e-07 1
+ 6.05e-07 1
+ )
Bdrive sn sp I=0.0035*v(q)
Rout sp sn 1meg
Bcompliance sp sn I=(max(v(sp,sn)-0.9,0)-max(-v(sp,sn)-0.9,0))/20
* Assumed ideal fast common-mode regulation, same current in both legs.
Bcmp sp cm I=0.05*(v(sp)+v(sn)-2*v(cm))
Bcmn sn cm I=0.05*(v(sp)+v(sn)-2*v(cm))
Cdp sp 0 2p
Cdn sn 0 2p
* QFN package: TI SBOC249 0.5ohm/2nH/0.3pF per pin.
Rpkp sp spp .5
Lpkp spp dp 2n
Cpkp dp 0 .3p
Rpkn sn snn .5
Lpkn snn dn 2n
Cpkn dn 0 .3p
Tdp dp 0 xp 0 Z0=50.0 TD=2.370155e-10
Rldp xp jp 0.4
Tcp jp 0 yp 0 Z0=50.0 TD=9.22018e-10
Rlcp yp zp 0.4
Lrxp zp rp 1e-09
Crxp rp 0 5e-12
Rleakp rp 0 100meg
Tdn dn 0 xn 0 Z0=50.0 TD=2.254802e-10
Rldn xn jn 0.4
Tcn jn 0 yn 0 Z0=50.0 TD=9.2178e-10
Rlcn yn zn 0.4
Lrxn zn rn 1e-09
Crxn rn 0 5e-12
Rleakn rn 0 100meg
.tran 25p 6.05e-07 0 25p
.save v(rp) v(rn) v(sp) v(sn) v(jp) v(jn) v(q)
.end
