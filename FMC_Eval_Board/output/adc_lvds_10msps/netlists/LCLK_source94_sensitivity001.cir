Bdrive sn sp I=0.0042*v(q)
Rout sp sn 1meg
Bcompliance sp sn I=(max(v(sp,sn)-0.55,0)-max(-v(sp,sn)-0.55,0))/20
* Assumed ideal fast common-mode regulation, same current in both legs.
Bcmp sp cm I=0.05*(v(sp)+v(sn)-2*v(cm))
Bcmn sn cm I=0.05*(v(sp)+v(sn)-2*v(cm))
Cdp sp 0 2p
Cdn sn 0 2p
* QFN package: TI SBOC249 0.5ohm/2nH/0.3pF per pin.
Rpkp sp spp .5
Lpkp spp dp 2n
Cpkp dp 0 .3p
Rpkn sn snn .5
Lpkn snn dn 2n
Cpkn dn 0 .3p
Rsrc sp sn 75.2
Tdp dp 0 xp 0 Z0=35.0 TD=3.690638e-10
Rldp xp jp 0.4
Tcp jp 0 yp 0 Z0=45.0 TD=8.887596e-10
Rlcp yp zp 0.4
Lrxp zp rp 1e-09
Crxp rp 0 1e-11
Rleakp rp 0 100meg
Tdn dn 0 xn 0 Z0=35.0 TD=3.777116e-10
Rldn xn jn 0.4
Tcn jn 0 yn 0 Z0=45.0 TD=8.884648e-10
Rlcn yn zn 0.4
Lrxn zn rn 1e-09
Crxn rn 0 1e-11
Rleakn rn 0 100meg
.tran 25p 6.05e-07 0 25p
.save v(rp) v(rn) v(sp) v(sn) v(jp) v(jn) v(q)
.end
