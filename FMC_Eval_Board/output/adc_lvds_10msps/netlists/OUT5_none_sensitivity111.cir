ADC LVDS OUT5 none: finite-compliance behavioral model
* Driver compliance is ASSUMED; no prediction of silicon damage.
.options reltol=0.002 abstol=1e-9 vntol=1e-6
Vcm cm 0 1.3
Vq q 0 PWL(
+ 0 1
+ 8e-08 1
+ 8.76333333333e-08 1
+ 8.90333333333e-08 -1
+ 9.59666666667e-08 -1
+ 9.73666666667e-08 1
+ 1.20966666667e-07 1
+ 1.22366666667e-07 -1
+ 1.293e-07 -1
+ 1.307e-07 1
+ 1.543e-07 1
+ 1.557e-07 -1
+ 1.70966666667e-07 -1
+ 1.72366666667e-07 1
+ 1.87633333333e-07 1
+ 1.89033333333e-07 -1
+ 2.043e-07 -1
+ 2.057e-07 1
+ 2.12633333333e-07 1
+ 2.14033333333e-07 -1
+ 2.20966666667e-07 -1
+ 2.22366666667e-07 1
+ 2.293e-07 1
+ 2.307e-07 -1
+ 2.37633333333e-07 -1
+ 2.39033333333e-07 1
+ 2.45966666667e-07 1
+ 2.47366666667e-07 -1
+ 2.543e-07 -1
+ 2.557e-07 1
+ 3.12633333333e-07 1
+ 3.14033333333e-07 -1
+ 3.62633333333e-07 -1
+ 3.64033333333e-07 1
+ 3.70966666667e-07 1
+ 3.72366666667e-07 -1
+ 4.12633333333e-07 -1
+ 4.14033333333e-07 1
+ 4.293e-07 1
+ 4.307e-07 -1
+ 4.62633333333e-07 -1
+ 4.64033333333e-07 1
+ 4.70966666667e-07 1
+ 4.72366666667e-07 -1
+ 4.793e-07 -1
+ 4.807e-07 1
+ 4.87633333333e-07 1
+ 4.89033333333e-07 -1
+ 5.12633333333e-07 -1
+ 5.14033333333e-07 1
+ 5.45966666667e-07 1
+ 5.47366666667e-07 -1
+ 5.62633333333e-07 -1
+ 5.64033333333e-07 1
+ 5.70966666667e-07 1
+ 5.72366666667e-07 -1
+ 5.95966666667e-07 -1
+ 5.97366666667e-07 1
+ 6.05e-07 1
+ )
Bdrive sn sp I=0.0042*v(q)
Rout sp sn 1meg
Bcompliance sp sn I=(max(v(sp,sn)-1.2,0)-max(-v(sp,sn)-1.2,0))/20
* Assumed ideal fast common-mode regulation, same current in both legs.
Bcmp sp cm I=0.05*(v(sp)+v(sn)-2*v(cm))
Bcmn sn cm I=0.05*(v(sp)+v(sn)-2*v(cm))
Cdp sp 0 2p
Cdn sn 0 2p
* QFN package: TI SBOC249 0.5ohm/2nH/0.3pF per pin.
Rpkp sp spp .5
Lpkp spp dp 2n
Cpkp dp 0 .3p
Rpkn sn snn .5
Lpkn snn dn 2n
Cpkn dn 0 .3p
Tdp dp 0 xp 0 Z0=65.0 TD=6.71108e-10
Rldp xp jp 0.4
Tcp jp 0 yp 0 Z0=55.0 TD=9.635877e-10
Rlcp yp zp 0.4
Lrxp zp rp 1e-09
Crxp rp 0 1e-11
Rleakp rp 0 100meg
Tdn dn 0 xn 0 Z0=65.0 TD=6.937016e-10
Rldn xn jn 0.4
Tcn jn 0 yn 0 Z0=55.0 TD=9.637264e-10
Rlcn yn zn 0.4
Lrxn zn rn 1e-09
Crxn rn 0 1e-11
Rleakn rn 0 100meg
.tran 25p 6.05e-07 0 25p
.save v(rp) v(rn) v(sp) v(sn) v(jp) v(jn) v(q)
.end
