[DISPLAYS]
BEGIN DISPLAY LAST SESSION
ANALYSIS AC_SWEEP
SYMBOL ALWAYS
TRACECOLORSCHEME NORMAL
BEGIN ANAPLOT 1
ACTIVE
XBASE
BEGIN XAXIS
XAXISUSERNAME 0 (null)
TEXT Frequency
RANGEFLAG AUTO
TYPE LOG
UNIT H
BEGIN GRIDS
MAJORSPACINGLINEAR 14285700
MAJORSPACINGLOG 1
MINORINTERVALS 10
MAJORNUMBERS
MAJORSTYLE LINES
MAJORPATTERN SOLID
MINORSTYLE LINES
MINORPATTERN DOT
END GRIDS
END XAXIS
BEGIN YAXIS 1
YAXISSIDE LEFT
ACTIVE
RANGEFLAG AUTO
TYPE LINEAR
UNIT  
BEGIN GRIDS
AUTOMATIC
MAJORNUMBERS
MAJORSTYLE LINES
MAJORPATTERN SOLID
MINORSTYLE LINES
MINORPATTERN DOT
END GRIDS
BEGIN TRACE DB(( V(VOUTP) - V(VOUTN) )/( V(IN+) - V(IN-) ))
MARKERID 1
END TRACE DB(( V(VOUTP) - V(VOUTN) )/( V(IN+) - V(IN-) ))
END YAXIS 1
END ANAPLOT 1
BEGIN MEASUREMENTS
SIZE 114
MEASNAMECOLWIDTH 361
BEGIN MEASUREMENT 1
NAME Cutoff_Lowpass_3dB(( V(VOUTP)-V(VOUTN))/(V(IN+))-V(IN-))
EVALUATE 1
END MEASUREMENT 1
BEGIN MEASUREMENT 2
NAME XatNthY(DB(( V(VOUTP) - V(VOUTN) )/( V(IN+) - V(IN-) )),-3,1)
EVALUATE 1
END MEASUREMENT 2
END MEASUREMENTS
END DISPLAY LAST SESSION
BEGIN DISPLAY LAST DISPLAY
ANALYSIS AC_SWEEP
SYMBOL ALWAYS
TRACECOLORSCHEME NORMAL
BEGIN ANAPLOT 1
ACTIVE
XBASE
BEGIN XAXIS
XAXISUSERNAME 0 (null)
TEXT Frequency
RANGEFLAG AUTO
TYPE LOG
UNIT H
BEGIN GRIDS
AUTOMATIC
MAJORNUMBERS
MAJORSTYLE LINES
MAJORPATTERN SOLID
MINORSTYLE LINES
MINORPATTERN DOT
END GRIDS
END XAXIS
BEGIN YAXIS 1
YAXISSIDE LEFT
ACTIVE
RANGEFLAG NORANGE
TYPE LINEAR
UNIT  
END YAXIS 1
END ANAPLOT 1
END DISPLAY LAST DISPLAY
[MEASUREMENTS]
AC 0 Cutoff_Lowpass_3dB(( V(VOUTP)-V(VOUTN))/(V(IN+))-V(IN-))
AC 0 XatNthY(DB(( V(VOUTP) - V(VOUTN) )/( V(IN+) - V(IN-) )),-3,1)
