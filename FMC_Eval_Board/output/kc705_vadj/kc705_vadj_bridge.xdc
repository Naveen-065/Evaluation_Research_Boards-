# Official KC705 master XDC: all used banks have fixed supplies, independent of VADJ.
set_property PACKAGE_PIN AD12 [get_ports sysclk_p]
set_property PACKAGE_PIN AD11 [get_ports sysclk_n]
set_property IOSTANDARD LVDS [get_ports {sysclk_p sysclk_n}]
create_clock -name sysclk_200mhz -period 5.000 [get_ports sysclk_p]
set_property PACKAGE_PIN AB8 [get_ports led0]
set_property IOSTANDARD LVCMOS15 [get_ports led0]
set_property PACKAGE_PIN AG17 [get_ports pmbus_scl]
set_property PACKAGE_PIN Y14 [get_ports pmbus_sda]
set_property IOSTANDARD LVCMOS15 [get_ports {pmbus_scl pmbus_sda}]
set_property DRIVE 4 [get_ports {pmbus_scl pmbus_sda led0}]
set_property SLEW SLOW [get_ports {pmbus_scl pmbus_sda led0}]
set_property BITSTREAM.CONFIG.UNUSEDPIN Pullnone [current_design]
set_property CFGBVS VCCO [current_design]
set_property CONFIG_VOLTAGE 2.5 [current_design]
