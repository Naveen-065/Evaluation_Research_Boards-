# Location of BUFG Primitives 
set_property LOC BUFGCTRL_X0Y1 [get_cells sysclk_global]
set_property LOC BUFGCTRL_X0Y3 [get_cells pll_feedback_buffer]
set_property LOC BUFGCTRL_X0Y2 [get_cells dbg_hub/inst/BSCANID.u_xsdbm_id/SWITCH_N_EXT_BSCAN.u_bufg_icon_tck]
set_property LOC BUFGCTRL_X0Y0 [get_cells adc_clock_buffer]

# Location of BUFIO Primitives 
set_property LOC BUFIO_X0Y2 [get_cells lclk_io_buffer]

# Location of BUFR Primitives 
set_property LOC BUFR_X0Y1 [get_cells lclk_fabric_buffer]

# Location of IO Primitives which is load of clock spine

# Location of clock ports
set_property LOC IOB_X0Y25 [get_ports lclk_n]
set_property LOC IOB_X0Y26 [get_ports lclk_p]
set_property LOC IOB_X1Y75 [get_ports sysclk_n]
set_property LOC IOB_X1Y76 [get_ports sysclk_p]

# Clock net "sysclk" driven by instance "sysclk_global" located at site "BUFGCTRL_X0Y1"
#startgroup
create_pblock {CLKAG_sysclk}
add_cells_to_pblock [get_pblocks  {CLKAG_sysclk}] [get_cells -filter { PRIMITIVE_GROUP != I/O && IS_PRIMITIVE==1 && PRIMITIVE_LEVEL !=INTERNAL && NAME!=adc_clock_pll} -of_object [get_pins -filter {DIRECTION==IN} -of_objects [get_nets -hierarchical -filter {PARENT=="sysclk"}]]]
resize_pblock [get_pblocks {CLKAG_sysclk}] -add {CLOCKREGION_X0Y0:CLOCKREGION_X0Y0}
#endgroup

# Clock net "lclk_fabric" driven by instance "lclk_fabric_buffer" located at site "BUFR_X0Y1"
#startgroup
create_pblock {CLKAG_lclk_fabric}
add_cells_to_pblock [get_pblocks  {CLKAG_lclk_fabric}] [get_cells -filter { PRIMITIVE_GROUP != I/O && IS_PRIMITIVE==1 && PRIMITIVE_LEVEL !=INTERNAL } -of_object [get_pins -filter {DIRECTION==IN} -of_objects [get_nets -hierarchical -filter {PARENT=="lclk_fabric"}]]]
resize_pblock [get_pblocks {CLKAG_lclk_fabric}] -add {CLOCKREGION_X0Y0:CLOCKREGION_X0Y0}
#endgroup

# Clock net "dbg_hub/inst/BSCANID.u_xsdbm_id/itck_i" driven by instance "dbg_hub/inst/BSCANID.u_xsdbm_id/SWITCH_N_EXT_BSCAN.u_bufg_icon_tck" located at site "BUFGCTRL_X0Y2"
#startgroup
create_pblock {CLKAG_dbg_hub/inst/BSCANID.u_xsdbm_id/itck_i}
add_cells_to_pblock [get_pblocks  {CLKAG_dbg_hub/inst/BSCANID.u_xsdbm_id/itck_i}] [get_cells -filter { PRIMITIVE_GROUP != I/O && IS_PRIMITIVE==1 && PRIMITIVE_LEVEL !=INTERNAL } -of_object [get_pins -filter {DIRECTION==IN} -of_objects [get_nets -hierarchical -filter {PARENT=="dbg_hub/inst/BSCANID.u_xsdbm_id/itck_i"}]]]
resize_pblock [get_pblocks {CLKAG_dbg_hub/inst/BSCANID.u_xsdbm_id/itck_i}] -add {CLOCKREGION_X0Y0:CLOCKREGION_X0Y0}
#endgroup

# Clock net "adc_clk_10m" driven by instance "adc_clock_buffer" located at site "BUFGCTRL_X0Y0"
#startgroup
create_pblock {CLKAG_adc_clk_10m}
add_cells_to_pblock [get_pblocks  {CLKAG_adc_clk_10m}] [get_cells -filter { PRIMITIVE_GROUP != I/O && IS_PRIMITIVE==1 && PRIMITIVE_LEVEL !=INTERNAL } -of_object [get_pins -filter {DIRECTION==IN} -of_objects [get_nets -hierarchical -filter {PARENT=="adc_clk_10m"}]]]
resize_pblock [get_pblocks {CLKAG_adc_clk_10m}] -add {CLOCKREGION_X0Y0:CLOCKREGION_X0Y0}
#endgroup
